# glibc's loader reads past short RPATH strings with its optimized strncmp.
# https://bugs.debian.org/1028504
{
   glibc_loader_dst_count_strncmp
   Memcheck:Addr8
   fun:strncmp
   fun:is_dst
   fun:_dl_dst_count
}
